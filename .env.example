# ====================================================================
# SMART FARMER AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' for local development or set in Render dashboard.
# NEVER commit your production secrets or actual API keys to GitHub.
# ====================================================================

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=local-development-only-change-me

# Database Configuration
# Local SQLite default: sqlite:///faemer.db
# Production PostgreSQL (Render automatically provides DATABASE_URL):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///faemer.db

# Automated Plant Disease Model Inference Endpoint (Optional)
# If left empty, the application transparently runs verified ICAR/University agronomic diagnostic keys.
# MODEL_API_URL=https://api.your-plant-ai-model.com/predict
# MODEL_API_KEY=your_optional_bearer_token

# OpenWeatherMap API Integration (Optional)
# If left blank, the system displays regional agro-climatic baseline advisories.
# Sign up for a free key at https://openweathermap.org/api
# WEATHER_API_KEY=your_openweathermap_api_key_here

# Default Port (Render sets this dynamically)
PORT=5000
